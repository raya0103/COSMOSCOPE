# SPHEREx Explorer Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Use sqlite for zero-config local development, or mysql for production
DB_TYPE=sqlite
SQLITE_PATH=backend/data/spherex.db

# Optional MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=spherex_user
MYSQL_PASSWORD=spherex_password
MYSQL_DATABASE=spherex_db

# NASA/IPAC IRSA Configuration
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP/sync
IRSA_IBE_URL=https://irsa.ipac.caltech.edu/ibe/data/spherex
FITS_CACHE_DIR=backend/data/cache/fits
MAX_CACHE_SIZE_MB=2048

# SIMBAD & CDS Services
CDS_SESAME_URL=https://cds.unistra.fr/cgi-bin/nph-sesame/-oxp/SNV
